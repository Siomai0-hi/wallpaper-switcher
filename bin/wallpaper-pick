#!/usr/bin/env bash
# Pick a wallpaper - rofi (Nord)
# Note: every notify-send is wrapped in `timeout 3` so a stuck notification
# daemon can never freeze the picker after a wallpaper was applied.
set -euo pipefail
IFS=$'\n'

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"   # sibling scripts live in the same dir

DEST="$HOME/.local/share/wallpapers"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wallpaper-switcher"
CFG="$CONF_DIR/config"
FAV_FILE="$CONF_DIR/favorites"
FAVMODE_FILE="$CONF_DIR/favmode"
THUMB_DIR="$HOME/.cache/wallpaper-pick/thumbs"
CTRL_DIR="$HOME/.cache/wallpaper-pick/ctrl"
THUMB_SIZE=160
ADD_LABEL="Add wallpaper"
SHUF_LABEL="Shuffle"
FAV_LABEL="Favorites"
ALL_LABEL="All images"
ROT_ON_LABEL="Auto-rotate: On"
ROT_OFF_LABEL="Auto-rotate: Off"

mkdir -p "$CONF_DIR" "$CTRL_DIR"
# shellcheck disable=SC1090   # config is a shell-sourced optional file
[ -f "$CFG" ] && . "$CFG"

# --- apply the image on whatever desktop session is running ------------------
# Backends by preference: swww (smooth fade on Hyprland), hyprpaper,
# swaybg, plasma-apply (KDE), feh; GNOME/XFCE use their own tools.
apply_wallpaper() {
  local img="$1" mon="${2:-}" de="${XDG_CURRENT_DESKTOP:-}"
  case "$de" in
    *GNOME*|*ubuntu*|*Cinnamon*|*Budgie*|*Pantheon*)
      command -v gsettings >/dev/null || return 1
      gsettings set org.gnome.desktop.background picture-uri "file://$img" 2>/dev/null || return 1
      gsettings set org.gnome.desktop.background picture-uri-dark "file://$img" 2>/dev/null || true
      return ;;
    *XFCE*)
      command -v xfconf-query >/dev/null || return 1
      xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/image-path -s "$img" 2>/dev/null || return 1
      xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/image-style -s 5 2>/dev/null || true
      return ;;
  esac
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    if command -v swww >/dev/null; then
      # smooth crossfade; -o targets one monitor when requested
      if [ -n "$mon" ]; then
        swww img "$img" -o "$mon" --transition-fade 2>/dev/null || return 1
      else
        swww img "$img" --transition-fade 2>/dev/null || return 1
      fi
      return
    fi
    if command -v hyprctl >/dev/null; then
      hyprctl hyprpaper preload "$img" >/dev/null 2>&1 || true
      hyprctl hyprpaper wallpaper ",$img" 2>/dev/null || return 1
      return
    fi
  fi
  if [ -n "${SWAYSOCK:-}" ] && command -v swaybg >/dev/null; then
    pkill -x swaybg 2>/dev/null || true
    swaybg -i "$img" -m fill &
    disown
    return
  fi
  if command -v plasma-apply-wallpaperimage >/dev/null; then
    plasma-apply-wallpaperimage "$img" 2>/dev/null && return || return 1
  fi
  if command -v feh >/dev/null; then
    feh --bg-fill "$img" 2>/dev/null && return || return 1
  fi
  return 1
}

# --- monitor detection --------------------------------------------------------
monitors() {  # per-monitor names, one per line (Hyprland / X11)
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
    hyprctl monitors -j 2>/dev/null | python3 -c 'import json,sys
for m in json.load(sys.stdin): print(m["name"])' 2>/dev/null || true
  elif [ -n "${DISPLAY:-}" ] && command -v xrandr >/dev/null; then
    xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $4}' || true
  fi
}

# --- optional pywal colorscheme extraction (PYWAL=1 in config) ----------------
maybe_pywal() {  # runs in the background; the app never blocks on it
  [ "${PYWAL:-0}" = 1 ] || return 0
  command -v wal >/dev/null || return 0
  ( wal -i "$1" -n -q >/dev/null 2>&1 &&
      timeout 3 notify-send -a wallpaper -t 3000 "Pywal" "Colorscheme updated" 2>/dev/null || true ) &
  disown
}

apply_one() {  # apply + notify + pywal; asks for a monitor when >1 connected
  local img="$1" mons target
  if [ -n "${MONITOR:-}" ]; then
    apply_wallpaper "$img" "$MONITOR" || return 1
  else
    mons="$(monitors | sed '/^$/d')"
    if [ "$(printf '%s' "$mons" | grep -c . 2>/dev/null || true)" -le 1 ]; then
      apply_wallpaper "$img" || return 1
    else
      target="$(printf 'All monitors\n%s\n' "$mons" |
        rofi -dmenu -i -p "Apply to" -theme wallpaper-nord-list 2>/dev/null || true)"
      if [ -z "$target" ] || [ "$target" = "All monitors" ]; then
        apply_wallpaper "$img" || return 1
      else
        apply_wallpaper "$img" "$target" || return 1
      fi
    fi
  fi
  timeout 3 notify-send -a wallpaper -i "$img" "Wallpaper" "${img##*/}" 2>/dev/null || true
  maybe_pywal "$img"
}

# kill any stale rofi from previous runs
for p in $(pgrep -x rofi || true); do kill "$p" 2>/dev/null || true; done
sleep 0.2

mapfile -t IMGS < <(
  find "$HOME/Desktop" "$HOME/.local/share/backgrounds" "$HOME/.local/share/wallpapers" \
       "$HOME/Pictures/wallpapers" "$HOME/Pictures/Wallpapers" -maxdepth 2 -type f \
       \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
          -o -iname '*.bmp' -o -iname '*.gif' \) 2>/dev/null | LC_ALL=C sort -u
)

# --- one-shot thumbnail pass --------------------------------------------------
# A cached square thumbnail per image has the filename baked in at the bottom.
# Full-size images are decoded only when the cache is cold (mtime check); from
# then on everything is read from disk, so RAM/CPU stay flat between launches.
THUMBS=0
if [ ${#IMGS[@]} -gt 0 ] && python3 -c 'import PIL' 2>/dev/null; then
  [ -d "$THUMB_DIR" ] || mkdir -p "$THUMB_DIR"
  if python3 - "$THUMB_DIR" "$THUMB_SIZE" "${IMGS[@]}" <<'PY' 2>/dev/null; then
import hashlib, os, sys
from PIL import Image, ImageDraw, ImageFont

cache, size = sys.argv[1], int(sys.argv[2])

font = None
for p in ("/usr/share/fonts/noto/NotoSans-Regular.ttf",
          "/usr/share/fonts/TTF/DejaVuSans.ttf",
          "/usr/share/fonts/dejavu/DejaVuSans.ttf"):
    if os.path.exists(p):
        font = ImageFont.truetype(p, max(10, size // 12))
        break
if font is None:
    font = ImageFont.load_default(size)

strip = max(14, size // 5)

for path in sys.argv[3:]:
    key = hashlib.sha256(path.encode()).hexdigest()[:16]
    out = os.path.join(cache, key + ".png")
    try:
        if os.path.getmtime(out) >= os.path.getmtime(path):
            continue                      # cache hit: skip decoding entirely
    except OSError:
        pass
    im = Image.open(path)
    try:
        im.draft("RGB", (size, size))     # decode only ~thumbnail resolution
    except Exception:
        pass
    im = im.convert("RGB")
    w, h = im.size
    s = min(w, h)
    im = im.crop(((w - s) // 2, (h - s) // 2, (w + s) // 2, (h + s) // 2))
    im = im.resize((size, size), Image.LANCZOS).convert("RGBA")
    ov = Image.new("RGBA", im.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(ov)
    d.rectangle((0, size - strip, size, size), fill=(10, 12, 16, 170))
    full = os.path.basename(path)
    name = full
    while name and font.getlength(name + "\u2026") > size - 14:
        name = name[:-1]
    if name != full:
        name += "\u2026"
    d.text((size // 2, size - strip // 2), name, font=font,
           fill=(236, 239, 244, 255), anchor="mm")
    Image.alpha_composite(im, ov).convert("RGB").save(out)
PY
    THUMBS=1
  fi
fi

thumb_of() {  # cached thumbnail path, or the file itself without Pillow
  local f="$1" key
  [ "$THUMBS" = 1 ] || { echo "$f"; return; }
  key=$(printf '%s' "$f" | sha256sum | cut -c1-16)
  echo "$THUMB_DIR/$key.png"
}

# --- labelled action tiles, rendered once and cached --------------------------
make_ctrl() {  # solid tile with a centred label (kept off-screen until needed)
  local slug="$1" label="$2"
  local out="$CTRL_DIR/$slug.png"
  [ -f "$out" ] && [ "$out" -nt "$0" ] && { echo "$out"; return; }
  python3 - "$out" "$label" <<'PY' 2>/dev/null || { echo "$out"; return; }
import os, sys
from PIL import Image, ImageDraw, ImageFont

out, label = sys.argv[1], sys.argv[2]
size = 160
font = None
for p in ("/usr/share/fonts/noto/NotoSans-Regular.ttf",
          "/usr/share/fonts/TTF/DejaVuSans.ttf",
          "/usr/share/fonts/dejavu/DejaVuSans.ttf"):
    if os.path.exists(p):
        font = ImageFont.truetype(p, max(16, size // 9))
        break
if font is None:
    font = ImageFont.load_default(size)
im = Image.new("RGB", (size, size), (59, 66, 82))   # Nord tile background
d = ImageDraw.Draw(im)
while font.getlength(label) > size - 24 and len(label) > 1:
    label = label[:-1]                    # keep the label on one line
d.text((size // 2, size // 2), label, font=font, fill=(236, 239, 244), anchor="mm")
im.save(out)
PY
  echo "$out"
}

# --- auto-rotate (systemd --user timer) + favourites view state ---------------
ROT_ON=0
if [ -f "$HOME/.config/systemd/user/wallpaper-rotate.timer" ]; then
  systemctl --user is-active wallpaper-rotate.timer >/dev/null 2>&1 && ROT_ON=1
fi
FAVMODE=0
[ -f "$FAVMODE_FILE" ] && FAVMODE=1

SHOWN=()   # images listed in the grid (all, or favourites only)
for f in "${IMGS[@]}"; do
  if [ "$FAVMODE" = 1 ]; then
    grep -qxF "$f" "$FAV_FILE" 2>/dev/null || continue
  fi
  SHOWN+=("$f")
done

add_file() {  # copy an image into the library
  local src="$1" dest name ext base i
  [ -f "$src" ] || return 1
  case "$(file -b --mime-type "$src" 2>/dev/null || echo x)" in
    image/*) ;;
    *)
      timeout 3 notify-send -a wallpaper -u critical "Wallpaper" "Not an image, skipped: ${src##*/}" 2>/dev/null || true
      return 1
      ;;
  esac
  name="${src##*/}"
  base="${name%.*}"; ext="${name##*.}"
  [ "$base" = "$ext" ] && ext="img"
  dest="$DEST/$name"
  i=1
  while [ -e "$dest" ]; do
    dest="$DEST/$base ($i).$ext"
    i=$((i + 1))
  done
  cp "$src" "$dest"
}

pick_file() {  # pick files via zenity and add them to the library
  local files added=0 f
  files="$(zenity --file-selection --multiple \
    --title="Add wallpaper" --filename="$HOME/Pictures/" \
    --file-filter="Image files (jpg jpeg png webp bmp gif) | *.jpg *.jpeg *.png *.webp *.bmp *.gif" \
    2>/dev/null || true)"
  [ -z "$files" ] && return 0   # cancelled
  IFS='|' read -ra arr <<<"$files"
  IFS=$'\n'
  for f in "${arr[@]}"; do
    [ -n "$f" ] || continue
    if add_file "$f"; then added=$((added + 1)); fi
  done
  if [ "$added" -gt 0 ]; then
    timeout 3 notify-send -a wallpaper -t 3000 "Wallpaper" "Added $added image(s)" 2>/dev/null || true
  fi
}

# --- grid ---------------------------------------------------------------------
gen_grid() {
  printf '%s\0icon\x1f%s\n' "$ADD_LABEL" "$(make_ctrl add "$ADD_LABEL")"
  if [ ${#IMGS[@]} -gt 0 ]; then
    printf '%s\0icon\x1f%s\n' "$SHUF_LABEL" "$(make_ctrl shuffle "$SHUF_LABEL")"
  fi
  if [ "$FAVMODE" = 1 ]; then
    printf '%s\0icon\x1f%s\n' "$ALL_LABEL" "$(make_ctrl all "$ALL_LABEL")"
  else
    printf '%s\0icon\x1f%s\n' "$FAV_LABEL" "$(make_ctrl fav "$FAV_LABEL")"
  fi
  if [ "$ROT_ON" = 1 ]; then
    printf '%s\0icon\x1f%s\n' "$ROT_ON_LABEL" "$(make_ctrl auto "$ROT_ON_LABEL")"
  else
    printf '%s\0icon\x1f%s\n' "$ROT_OFF_LABEL" "$(make_ctrl autof "$ROT_OFF_LABEL")"
  fi
  for f in "${SHOWN[@]}"; do
    printf '%s\0icon\x1f%s\n' "$(basename "$f")" "$(thumb_of "$f")"
  done
}

if sel="$(gen_grid | rofi -dmenu -i -p "Wallpaper" -show-icons 2>/dev/null)"; then
  rc=0
else
  rc=$?   # 1 = cancelled, 10 = kb-custom-1 (Ctrl+R -> random apply)
fi
[ -n "$sel" ] || exit 0

if [ "$rc" -eq 10 ] && [ ${#IMGS[@]} -gt 0 ]; then   # Ctrl+R: apply a random image
  apply_one "${IMGS[$((RANDOM % ${#IMGS[@]}))]}" ||
    timeout 3 notify-send -a wallpaper -u critical "Wallpaper" "Failed to apply wallpaper" 2>/dev/null || true
  exit 0
fi

case "$sel" in
  "$ADD_LABEL")
    [ -d "$DEST" ] || mkdir -p "$DEST"
    pick_file
    exec "$0" ;;
  "$SHUF_LABEL")
    apply_one "${IMGS[$((RANDOM % ${#IMGS[@]}))]}" ||
      timeout 3 notify-send -a wallpaper -u critical "Wallpaper" "Failed to apply wallpaper" 2>/dev/null || true
    ;;
  "$FAV_LABEL"|"$ALL_LABEL")
    if [ "$FAVMODE" = 1 ]; then rm -f "$FAVMODE_FILE"; else : > "$FAVMODE_FILE"; fi
    exec "$0" ;;
  "$ROT_ON_LABEL"|"$ROT_OFF_LABEL")
    if [ "$ROT_ON" = 1 ]; then "$BIN_DIR/wallpaper-rotate" off; else "$BIN_DIR/wallpaper-rotate" on; fi
    exec "$0" ;;
  *)
    picked=""
    for f in "${SHOWN[@]}"; do
      if [ "$(basename "$f")" = "$sel" ]; then picked="$f"; break; fi
    done
    if [ -n "$picked" ]; then
      apply_one "$picked" ||
        timeout 3 notify-send -a wallpaper -u critical "Wallpaper" "Failed to apply wallpaper" 2>/dev/null || true
    fi
    ;;
esac