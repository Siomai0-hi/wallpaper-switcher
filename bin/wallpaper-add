#!/usr/bin/env bash
# Шинэ хананы зураг нэмэх:  wallpaper-add <зураг файл> [өөр файл...]
# Зургийг хананы зургийн санд хуулж, дараагийн wallpaper-pick дээр гаргана
set -euo pipefail

[ $# -ge 1 ] || { echo "Хэрэглээ: wallpaper-add <зураг файл> [өөр файл...]"; exit 1; }

DEST="${WALLPAPER_DIR:-$HOME/.local/share/wallpapers}"
mkdir -p "$DEST"

for src in "$@"; do
  [ -f "$src" ] || { echo "Файл олдсонгүй: $src"; continue; }
  case "$(file -b --mime-type "$src" 2>/dev/null || echo x)" in
    image/*) ;;
    *) echo "Зураг биш файлыг алгаслаа: $src"; continue ;;
  esac

  base="${src##*/}"
  name="${base%.*}"
  ext="${base##*.}"
  [ "$name" = "$ext" ] && ext="img"
  dest="$DEST/$base"
  i=1
  while [ -e "$dest" ]; do
    dest="$DEST/$name ($i).$ext"
    i=$((i + 1))
  done
  cp "$src" "$dest"
  echo "Нэмэгдсэн: $dest"
done
echo "\"wallpaper-pick\" нээвэл шинэ зураг харагдана"