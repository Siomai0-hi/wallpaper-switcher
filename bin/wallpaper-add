#!/usr/bin/env bash
# Add new wallpapers:  wallpaper-add <image file> [more files...]
set -euo pipefail

[ $# -ge 1 ] || { echo "Usage: wallpaper-add <image file> [more files...]"; exit 1; }

DEST="${WALLPAPER_DIR:-$HOME/.local/share/wallpapers}"
mkdir -p "$DEST"

for src in "$@"; do
  [ -f "$src" ] || { echo "File not found: $src"; continue; }
  case "$(file -b --mime-type "$src" 2>/dev/null || echo x)" in
    image/*) ;;
    *) echo "Skipped non-image file: $src"; continue ;;
  esac

  base="${src##*/}"
  name="${base%.*}"
  ext="${base##*.}"
  [ "$name" = "$ext" ] && ext="img"
  dest="$DEST/$base"
  i=1
  while [ -e "$dest" ]; do
    dest="$DEST/$name ($i).$ext"
    i=$((i + 1))
  done
  cp "$src" "$dest"
  echo "Added: $dest"
done
echo 'Open "wallpaper-pick" to see the new image'