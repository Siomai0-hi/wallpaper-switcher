#!/usr/bin/env bash
# Хананы зургийг хурдан солих: next | prev | random | <тоо>
# Хэрэглээ:   wallpaper-cycle next      (дараагийн зураг)
#             wallpaper-cycle prev      (өмнөх зураг)
#             wallpaper-cycle random    (санамсаргүй)
set -euo pipefail

STATE="$HOME/.cache/wallpaper-cycle-idx"

mapfile -t IMGS < <(
  find "$HOME/Desktop" "$HOME/.local/share/backgrounds" "$HOME/.local/share/wallpapers" \
       "$HOME/Pictures/wallpapers" "$HOME/Pictures/Wallpapers" -maxdepth 2 -type f \
       \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
          -o -iname '*.bmp' -o -iname '*.gif' \) 2>/dev/null | LC_ALL=C sort -u
)
if [ ${#IMGS[@]} -eq 0 ]; then
  notify-send -a wallpaper -u critical "Wallpaper" "Зураг олдсонгүй" 2>/dev/null || true
  exit 1
fi
N=${#IMGS[@]}

mode="${1:-next}"
case "$mode" in
  random) idx=$((RANDOM % N)) ;;
  next)   idx=$(cat "$STATE" 2>/dev/null || echo 0); idx=$(( (idx + 1) % N )) ;;
  prev)   idx=$(cat "$STATE" 2>/dev/null || echo 0); idx=$(( (idx - 1 + N) % N )) ;;
  *[!0-9]*) usage=1; idx=0 ;;
  *)      idx=$((10#$mode % N)) ;;   # шууд дугаар
esac
[ -z "${usage:-}" ] || { echo "Хэрэглээ: wallpaper-cycle next|prev|random|<тоо>"; exit 1; }

if /usr/bin/plasma-apply-wallpaperimage "${IMGS[$idx]}" 2>/dev/null; then
  echo "${IMGS[$idx]}"
  notify-send -a wallpaper -i "${IMGS[$idx]}" "Wallpaper  $((idx+1))/$N" "${IMGS[$idx]##*/}" 2>/dev/null || true
else
  echo "plasma-apply-wallpaperimage амжилтгүй" >&2
  exit 1
fi